{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
    "ReverseProxy": {
      "Routes": {
        "ProductRoute": {
          "ClusterId": "productCluster",
          "Match": {
            "Path": "/api/product/{**catch-all}"
          }
        },
        "userRoute": {
          "ClusterId": "userCluster",
          "Match": {
            "Path": "/users/{**catch-all}"
          }
        },
        "orderRoute": {
          "ClusterId": "orderCluster",
          "Match": {
            "Path": "/orders/{**catch-all}"
          }
        }
      },
      "Clusters": {
        "productCluster": {
          "Destinations": {
            "destination1": {
              "Address": "https://localhost:7003/"
            }
          }
        },
        "userCluster": {
          "Destinations": {
            "destination1": {
              "Address": "https://localhost:7202/"
            }
          }
        },
        "orderCluster": {
          "Destinations": {
            "destination1": {
              "Address": "https://localhost:7259/"
            }
          }
        }
      }
    },
  "AllowedHosts": "*"
}
